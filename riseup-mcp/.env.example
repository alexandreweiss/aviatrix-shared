# Copy this file to .env and fill in your Rise Up API credentials.
# Find your keys at: Settings > Developer > API in the Rise Up admin portal.

RISEUP_PUBLIC_KEY=your_public_key_here
RISEUP_PRIVATE_KEY=your_private_key_here

# Optional: use preprod URL for testing
# RISEUP_API_BASE=https://preprod-customer-api.riseup.ai
RISEUP_API_BASE=https://api.riseup.ai
